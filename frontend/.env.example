# Copia este archivo como .env y completa los valores reales
# NUNCA subas el .env al repositorio

# URL base del backend Django (sin slash final)
# Desarrollo:
REACT_APP_API_URL=http://localhost:8000/api
# Producción:
# REACT_APP_API_URL=https://vialtros.ds1.eleueleo.com/api

# URL base del WebSocket (se deriva automáticamente de REACT_APP_API_URL si no se define)
# Desarrollo:
REACT_APP_WS_URL=ws://localhost:8000/ws
# Producción:
# REACT_APP_WS_URL=wss://vialtros.ds1.eleueleo.com/ws

# API Key de Google Maps JavaScript API
# Obtener en: https://console.cloud.google.com → APIs & Services → Credentials
REACT_APP_GOOGLE_MAPS_API_KEY=AIzaSyCyWJaWYy0TbNVc2VoLbJzPPa80haHV-wA
