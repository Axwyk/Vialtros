# Copia este archivo como .env y completa los valores reales
# NUNCA subas el .env al repositorio

# URL base del backend Django (sin slash final)
# Desarrollo:
REACT_APP_API_URL=http://localhost:8000/api
# Producción:
# REACT_APP_API_URL=https://vialtros.ds1.eleueleo.com/api

# URL base del WebSocket (se deriva automáticamente de REACT_APP_API_URL si no se define)
# Desarrollo:
REACT_APP_WS_URL=ws://localhost:8000/ws
# Producción:
# REACT_APP_WS_URL=wss://vialtros.ds1.eleueleo.com/ws

# API Key de Google Maps JavaScript API
# Obtener en: https://console.cloud.google.com → APIs & Services → Credentials
REACT_APP_GOOGLE_MAPS_API_KEY=

# Map ID para Vector Maps (heading + tilt 3D en modo GPS):
# Crear en console.cloud.google.com → Maps Platform → Map Management → tipo "Vector"
REACT_APP_GOOGLE_MAPS_MAP_ID=

# API Key para Google Routes API (calculo de rutas por calles)
# Si no se define, se usa REACT_APP_GOOGLE_MAPS_API_KEY como fallback
# Asegurarse de que la key tenga habilitada la Routes API en Google Cloud Console
REACT_APP_GOOGLE_ROUTES_API_KEY=

# Token de Mapbox para renderizado de mapa vectorial (opcional)
# Si no se define, el mapa usa CartoDB como fallback gratuito
# Obtener en: https://account.mapbox.com/access-tokens/
REACT_APP_MAPBOX_TOKEN=
