# Backend — plantilla de variables de entorno
# Copia este archivo como .env y rellena los valores reales

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=vialtros_db
DB_USER=vialtros_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email para recuperación de contraseña (Gmail con App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_aqui
FRONTEND_URL=http://localhost:3000

# Token para autenticar dispositivos GPS hardware (rastreadores, dongles USB, etc.)
# Usa este token en el header X-Tracking-Token al POST /api/tracking/ingest/
TRACKING_INGEST_TOKEN=cambia-esto-por-un-token-secreto

# Solo necesario en producción (DEBUG=False)
# CORS_ALLOWED_ORIGINS=https://www.vialtros.com
