# ── Python / Django ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Entorno virtual
venv/
.venv/
env/
.env/

# Variables de entorno (nunca subir secrets)
.env
.env.*
!.env.example

# Base de datos SQLite (desarrollo)
db.sqlite3
*.sqlite3

# Archivos de compilación Python
*.egg-info/
dist/
build/
*.egg

# Migraciones autogeneradas (opcional: quitar si quieres versionar migraciones)
# backend/*/migrations/

# Pytest / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# mypy
.mypy_cache/

# ── Node.js / React ───────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Build de producción
frontend/build/
frontend/coverage/

# Logs de npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Sistemas operativos ───────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDEs y editores ───────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Archivos estáticos recolectados (Django) ──────────────────
staticfiles/
static_root/
media/

# ── Logs generales ────────────────────────────────────────────
*.log
