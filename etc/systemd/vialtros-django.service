[Unit]
Description=Vialtros Django Application (Daphne ASGI)
After=network.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/var/www/ds1/Vialtros/backend
Environment="PATH=/var/www/ds1/Vialtros/backend/venv/bin"
EnvironmentFile=/var/www/ds1/Vialtros/backend/.env

# Daphne (ASGI) para soportar WebSockets via Django Channels
ExecStart=/var/www/ds1/Vialtros/backend/venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8000 \
    core.asgi:application

# Reiniciar si falla
Restart=always
RestartSec=10

# Timeouts
StartLimitBurst=5
StartLimitInterval=60s

# Seguridad
NoNewPrivileges=true
PrivateTmp=true

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vialtros-django

[Install]
WantedBy=multi-user.target
